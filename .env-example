# Официальный DeepSeek API: V4.1-Flash вызывается именем deepseek-flash.
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
OPENAI_API_KEY=свой_ключ_DeepSeek
# Также принимается имя DEEPSEEK_API_KEY вместо OPENAI_API_KEY.

# max — полный бюджет reasoning; также доступны low/high/none.
REASONING_EFFORT=max

AGENTS_ROOT=./agents
ENABLE_BASH_TOOL=1
TEMPERATURE=0.7
# Длина одной жизни агента (по умолчанию 30 итераций).
# SESSION_ITERATIONS=30
# SLEEP_WARN_REMAINING=10

BRAVE_KEY=свой_ключ_Brave

# Для старого профиля DeepInfra замените первые две строки на:
# OPENAI_BASE_URL=https://api.deepinfra.com/v1/openai
# OPENAI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
