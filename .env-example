OPENAI_BASE_URL=https://api.deepinfra.com/v1/openai
# Обе модели используют один OpenAI-совместимый endpoint DeepInfra:
OPENAI_MODEL=zai-org/GLM-5.3-Flash
# Для DeepSeek используйте вместо строки выше:
# OPENAI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
OPENAI_API_KEY=свой вставляй :)

# max поддерживается обеими моделями (xhigh тоже оставлен совместимым для
# DeepSeek; для GLM он автоматически приводится к max).
REASONING_EFFORT=max

AGENTS_ROOT=./agents
ENABLE_BASH_TOOL=1
TEMPERATURE=0.7
# Длина одной жизни агента (по умолчанию 30 итераций).
# SESSION_ITERATIONS=30
# SLEEP_WARN_REMAINING=10

BRAVE_KEY=свой вставляй :)